{
  "name": "KYCAPI",
  "version": "1.0.0",
  "context": "/kyc",
  "description": "KYC API for person information lookup by NIC",
  "type": "HTTP",
  "transport": ["http", "https"],
  "endpointConfig": {
    "endpoint_type": "http",
    "production_endpoints": {"url": "http://mock-backend:3002"},
    "sandbox_endpoints": {"url": "http://mock-backend:3002"}
  },
  "operations": [
    {
      "target": "/user/{nic}",
      "verb": "GET",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited"
    }
  ],
  "policies": ["DefaultSubscriptionless"],
  "subscriptionAvailability": "CURRENT_TENANT",
  "visibility": "PUBLIC",
  "gatewayVendor": "wso2",
  "gatewayType": "wso2/synapse"
}
